class CircularDequeue(CircularQueue):
    def __init__(self, capacity = 10):
        super().__init__(capacity) #부모 클래스의 생성자 호출

    #기존의 구현된 코드 : add_rear, delete_front, get_front
    def addRear(self, e): self.enqueue(e)
    def deleteFront(self): return self.dequeue()
    def getFront(self): return self.peek()

    #새롭게 구현할 코드 : delete_rear, add_front, get_rear

    def deleteRear(self):
        if not self.isEmpty():
            save = self.array[self.rear]
            self.rear = (self.rear - 1 + self.capacity) % self.capacity
            return save
        else:
            exit()

    def addFront(self, e):
        if not self.isFull():
            self.array[self.front] = e
            self.front = (self.front - 1 + self.capacity)%self.capacity
        else:
            exit()

    def getRear(self):
        if not self.isEmpty():
            return self.array[self.rear]
        else:
            exit()
